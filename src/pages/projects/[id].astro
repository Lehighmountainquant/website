---
import { getCollection, render, type CollectionEntry } from 'astro:content';
import 'katex/dist/katex.min.css';
import Base from '../../layouts/Base.astro';
import { url, formatDate } from '../../lib/utils';

export async function getStaticPaths() {
  const projects = await getCollection('projects', (p) => !p.data.draft);
  return projects.map((project) => ({ params: { id: project.id }, props: { project } }));
}

interface Props { project: CollectionEntry<'projects'> }
const { project } = Astro.props;
const { Content } = await render(project);
const { title, summary, authors, date, tags, code, pdf } = project.data;
---

<Base title={title} description={summary}>
  <article class="wrap">
    <header class="page-head">
      <p class="eyebrow"><a href={url('/projects/')}>← Research</a></p>
      <h1>{title}</h1>
      <p class="lede">{summary}</p>
      <p class="byline">
        <span>{authors.join(', ')}</span>
        <span class="muted">{formatDate(date, { timeZone: 'UTC' })}</span>
        {pdf && <a href={url(pdf)} target="_blank" rel="noopener">Read the paper (PDF) ↗</a>}
        {code && <a href={code}>View code ↗</a>}
      </p>
      {tags.length > 0 && <p>{tags.map((t) => <span class="tag">{t}</span>)}</p>}
    </header>
    <div class="prose">
      <Content />
    </div>
    <p class="disclaimer muted">Student research for educational purposes. Not investment advice.</p>
  </article>
</Base>

<style>
  .byline { display: flex; flex-wrap: wrap; gap: 0.4rem 1.25rem; font-size: 0.95rem; margin-top: 1rem; }
  .eyebrow a { color: inherit; text-decoration: none; }
  .eyebrow a:hover { color: var(--accent); }
  .disclaimer { font-size: 0.85rem; margin-top: 3rem; padding-top: 1rem; border-top: 1px solid var(--rule); max-width: var(--prose); }
</style>
