---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import EventCard from '../components/EventCard.astro';
import { club } from '../config';
import { url, formatDate, seeded } from '../lib/utils';

const events = (await getCollection('events')).sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());
const recent = events.slice(0, 2);

const projects = (await getCollection('projects', (p) => !p.data.draft))
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());
const research = projects.slice(0, 3);

const team = (await getCollection('team')).sort((a, b) => a.data.order - b.data.order);
const initials = (name: string) => name.split(/\s+/).map((w) => w[0]).slice(0, 2).join('');

// Every meeting so far, oldest first, for the market-tape ticker under the hero
const tape = [...events].reverse().map((e, i) => ({
  n: String(i + 1).padStart(2, '0'),
  title: e.data.title.replace(/^Guest Speaker:\s*/i, ''),
  date: formatDate(e.data.date, { month: '2-digit', day: '2-digit', year: undefined, timeZone: 'UTC' }).replace('/', '.'),
}));

// "The Range": stacked probability densities that form a mountain range (after the logo).
// Each row is a slightly shifted distribution, like a prior updating toward a posterior.
const rnd = seeded(11);
const W = 2000, H = 520, ROWS = 22, P = 160, HOT = ROWS - 4;
const bell = (x: number, m: number, s: number) => Math.exp(-((x - m) ** 2) / (2 * s * s));
const ridges = Array.from({ length: ROWS }, (_, r) => {
  const t = r / (ROWS - 1); // 0 = back row, 1 = front row
  const peaks = [
    { m: 0.58 + 0.22 * t, s: 0.07 + 0.03 * rnd(), a: 1 }, // main summit drifts right
    { m: 0.3 + 0.12 * rnd(), s: 0.1, a: 0.25 + 0.2 * rnd() },
    { m: 0.88, s: 0.04, a: 0.25 * rnd() },
    ...Array.from({ length: 4 }, () => ({ m: rnd(), s: 0.015 + 0.02 * rnd(), a: 0.05 + 0.1 * rnd() })),
  ];
  const base = 150 + r * 17, amp = 70 + 210 * t;
  const pts = Array.from({ length: P }, (_, i) => {
    const x = i / (P - 1);
    const y = peaks.reduce((sum, p) => sum + p.a * bell(x, p.m, p.s), 0);
    return `${(x * W).toFixed(1)},${(base - y * amp + (rnd() - 0.5) * 1.2).toFixed(1)}`;
  });
  return { d: `M0,${H} L${pts.join(' L')} L${W},${H} Z`, r, t };
});
---

<Base>
  <section class="hero">
    <div class="grid-bg" aria-hidden="true"></div>
    <svg class="range" viewBox={`0 0 ${W} ${H}`} preserveAspectRatio="xMaxYMax slice" aria-hidden="true">
      {ridges.map(({ d, r, t }) => (
        <path
          d={d}
          class={r === HOT ? 'hot' : undefined}
          style={`--i:${r}; --fill:color-mix(in srgb, #4d2b0e ${Math.round((1 - t) * 100)}%, #3a1f08); --edge:${(0.22 + 0.12 * t).toFixed(2)}`}
        />
      ))}
    </svg>

    <div class="wrap hero-inner">
      <h1>{club.name}</h1>
      <p class="lede">{club.tagline}</p>
      <p class="cta">
        <a href={club.groupmeUrl} class="btn btn-gold" rel="noopener" target="_blank">Join our GroupMe</a>
        <a href={url('/events/')} class="btn btn-line">Past meetings →</a>
        {club.social.linkedin && <a href={club.social.linkedin} class="btn btn-line" rel="noopener" target="_blank">LinkedIn ↗</a>}
      </p>
      <p class="meet mono"><span class="dot" aria-hidden="true"></span>{club.meetings}</p>
    </div>

    {tape.length > 0 && (
      <div class="ticker" aria-label="Meetings so far">
        <span class="badge">Topics</span>
        <div class="track">
          {[0, 1].map((copy) => (
            <ul aria-hidden={copy === 1 ? 'true' : undefined}>
              {tape.map((x) => (
                <li><span class="n">#{x.n}</span>{x.title}<span class="d">{x.date}</span></li>
              ))}
            </ul>
          ))}
        </div>
      </div>
    )}
  </section>

  <div class="wrap">
    <section>
      <div class="section-head">
        <h2>Recent meetings</h2>
        <a href={url('/events/')}>All meetings →</a>
      </div>
      {recent.length > 0
        ? recent.map((e) => <EventCard event={e} preview />)
        : <p class="empty">Meeting recaps will show up here after our first meeting.</p>}
    </section>

    {research.length > 0 && (
      <section>
        <div class="section-head">
          <h2>Member research</h2>
          <a href={url('/projects/')}>All research →</a>
        </div>
        <div class="grid grid-3">
          {research.map((p) => (
            <a class="card research" href={url(`/projects/${p.id}/`)}>
              <p class="eyebrow">{formatDate(p.data.date, { day: undefined, timeZone: 'UTC' })}</p>
              <h3>{p.data.title}</h3>
              <p class="muted">{p.data.summary}</p>
            </a>
          ))}
        </div>
      </section>
    )}

    {team.length > 0 && (
      <section>
        <div class="section-head">
          <h2>Leadership</h2>
          <a href={url('/about/')}>Meet the board →</a>
        </div>
        <ul class="board">
          {team.map((m) => (
            <li>
              <a href={url('/about/')}>
                {m.data.photo
                  ? <img src={url(m.data.photo)} alt="" loading="lazy" width="96" height="96" />
                  : <span class="ph" aria-hidden="true">{initials(m.data.name)}</span>}
                <span class="who">{m.data.name}</span>
                <span class="role">{m.data.role}</span>
              </a>
            </li>
          ))}
        </ul>
      </section>
    )}

    <section class="band">
      <div>
        <p class="eyebrow">For firms</p>
        <h2>Recruiting at a trading firm?</h2>
        <p>We connect sponsors with students who can actually code, reason under uncertainty, and explain their work.</p>
      </div>
      <a href={url('/sponsors/')} class="btn btn-gold">Partner with us</a>
    </section>
  </div>
</Base>

<style>
  /* ── Hero: dark Lehigh Brown "trading screen" ─────────────── */
  .hero {
    position: relative; overflow: hidden;
    background: radial-gradient(120% 90% at 85% 0%, #6a3f17 0%, var(--brown) 55%, #3a1f08 100%);
    color: #f6f4f2;
  }
  .grid-bg {
    position: absolute; inset: 0;
    background-image:
      linear-gradient(rgba(255, 255, 255, 0.05) 1px, transparent 1px),
      linear-gradient(90deg, rgba(255, 255, 255, 0.05) 1px, transparent 1px);
    background-size: 56px 56px;
    mask-image: linear-gradient(to bottom, transparent, #000 30%, #000 75%, transparent);
  }
  .range { position: absolute; left: 0; right: 0; bottom: 3rem; width: 100%; height: calc(88% - 3rem);
    mask-image: linear-gradient(to bottom, transparent, #000 10%); }
  .range path {
    fill: var(--fill); stroke: rgba(255, 228, 30, var(--edge)); stroke-width: 1; vector-effect: non-scaling-stroke;
    opacity: 0; animation: rise 0.9s cubic-bezier(0.2, 0.7, 0.2, 1) calc(var(--i) * 60ms) forwards;
  }
  .range path.hot { stroke: rgba(255, 228, 30, 0.5); stroke-width: 1.25; filter: drop-shadow(0 0 4px rgba(255, 228, 30, 0.2)); }
  @keyframes rise { from { opacity: 0; transform: translateY(12px); } to { opacity: 1; transform: none; } }

  .hero-inner { position: relative; padding-top: clamp(3.5rem, 10vw, 7rem); padding-bottom: clamp(6.5rem, 12vw, 9rem); }
  .hero .eyebrow { color: var(--gold); }
  .hero h1 { max-width: 14ch; color: #fff; font-size: clamp(2.5rem, 6vw, 4rem); }
  .hero h1::after { content: ''; display: block; width: 4rem; height: 5px; background: var(--gold); margin-top: 1rem; }
  .hero .lede { color: var(--brown-20); }
  .cta { display: flex; flex-wrap: wrap; gap: 0.6rem; margin-top: 1.75rem; }
  .btn-line { border-color: rgba(255, 255, 255, 0.3); color: #fff; }
  .btn-line:hover { border-color: var(--gold); color: #fff; }
  .meet { display: flex; align-items: center; gap: 0.55rem; font-size: 0.85rem; margin-top: 1.25rem; color: var(--brown-20); }
  .dot { width: 7px; height: 7px; border-radius: 50%; background: var(--gold); }

  /* Market-tape ticker of every meeting so far */
  .ticker {
    position: absolute; left: 0; right: 0; bottom: 0; height: 3rem; overflow: hidden;
    display: flex; align-items: center;
    background: #241304; border-top: 1px solid rgba(255, 228, 30, 0.45); border-bottom: 1px solid #000;
    font-family: var(--mono); font-size: 0.78rem; letter-spacing: 0.08em; text-transform: uppercase;
    font-variant-numeric: tabular-nums;
  }
  .badge {
    position: absolute; left: 0; top: 0; bottom: 0; z-index: 1;
    display: flex; align-items: center; padding: 0 1rem;
    background: var(--gold); color: var(--brown); font-weight: 500;
    box-shadow: 12px 0 18px -6px #241304;
  }
  .track { display: flex; width: max-content; animation: scroll 45s linear infinite; }
  .ticker:hover .track { animation-play-state: paused; }
  .track ul { display: flex; list-style: none; margin: 0; padding: 0; }
  .track li { white-space: nowrap; padding: 0 1.5rem; color: #fff; }
  .track li::before { content: '▲'; color: var(--gold); font-size: 0.6rem; margin-right: 0.75rem; vertical-align: 0.1em; }
  .track .n { color: var(--gold); margin-right: 0.7rem; }
  .track .d { color: var(--brown-20); margin-left: 0.7rem; }
  @keyframes scroll { to { transform: translateX(-50%); } }

  @media (prefers-reduced-motion: reduce) {
    .range path { animation: none; opacity: 1; }
    .track { animation: none; padding-left: 6rem; }
    .ticker { overflow-x: auto; }
  }

  /* ── Sections ─────────────────────────────────────────────── */
  .wrap > section:first-child { margin-top: 4rem; }

  .section-head { display: flex; align-items: baseline; justify-content: space-between; gap: 1rem; border-bottom: 1px solid var(--rule); padding-bottom: 0.5rem; }
  .section-head h2 { margin: 0; }
  .section-head a { font-size: 0.92rem; white-space: nowrap; }

  .research { text-decoration: none; color: inherit; transition: border-color 0.15s, transform 0.15s; margin-top: 1.25rem; }
  .research:hover { border-color: var(--accent); transform: translateY(-2px); }
  .research h3 { color: var(--ink); }

  .board { list-style: none; padding: 0; margin: 1.5rem 0 0; display: grid; gap: 1.5rem 1rem; grid-template-columns: repeat(2, 1fr); }
  @media (min-width: 720px) { .board { grid-template-columns: repeat(4, 1fr); } }
  .board a { display: flex; flex-direction: column; align-items: center; text-align: center; text-decoration: none; color: inherit; }
  .board img, .board .ph {
    width: 6rem; height: 6rem; border-radius: 50%; object-fit: cover;
    border: 3px solid var(--surface); box-shadow: 0 0 0 1px var(--rule); transition: box-shadow 0.15s;
  }
  .board .ph { display: grid; place-items: center; background: var(--tint); font-family: var(--serif); font-size: 1.6rem; color: var(--brown); }
  .board a:hover img, .board a:hover .ph { box-shadow: 0 0 0 3px var(--gold); }
  .who { margin-top: 0.7rem; font-weight: 500; line-height: 1.3; }
  .role { font-size: 0.82rem; color: var(--ink-3); line-height: 1.35; margin-top: 0.15rem; }

  .band {
    display: flex; flex-direction: column; gap: 1.25rem; padding: 2.25rem 2rem;
    background: var(--brown); color: #f6f4f2; border-radius: var(--radius); border-left: 6px solid var(--gold);
  }
  .band .eyebrow { color: var(--gold); }
  .band h2 { color: #fff; margin-bottom: 0.3em; }
  .band p:not(.eyebrow) { color: var(--brown-20); }
  .band .btn { white-space: nowrap; align-self: flex-start; }
  @media (min-width: 720px) { .band { flex-direction: row; align-items: center; justify-content: space-between; } .band p:last-child { margin: 0; } }
</style>
