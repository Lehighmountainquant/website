---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import { club } from '../config';
import { url } from '../lib/utils';

const team = (await getCollection('team')).sort((a, b) => a.data.order - b.data.order);
const initials = (name: string) => name.split(/\s+/).map((w) => w[0]).slice(0, 2).join('');
---

<Base title="About" description={`Who we are and who runs the ${club.name}.`}>
  <div class="wrap">
    <header class="page-head">
      <p class="eyebrow">About</p>
      <h1>Who we are</h1>
      <p class="lede">{club.description}</p>
    </header>

    <section class="prose">
      <h2>What we do</h2>
      <p>
        Quantitative finance sits where math, statistics, and programming meet markets. We meet weekly to work through
        that material together — from expected value and Kelly betting to backtesting and options pricing — and we try to
        keep every session hands-on.
      </p>
      <p>
        Members come from math, computer science, engineering, physics, economics, and finance. You don't need prior
        experience; you need curiosity and a willingness to write some code.
      </p>
      <h2>How to get involved</h2>
      <ul>
        <li>Come to a general meeting: <strong>{club.meetings}</strong></li>
        <li><a href={club.groupmeUrl} target="_blank" rel="noopener">Join our GroupMe</a> for meeting announcements and updates</li>
        <li>Pitch a research project or join an existing team at the start of each semester</li>
      </ul>
    </section>

    <section>
      <h2>Leadership</h2>
      <div class="team">
        {team.map((m) => {
          const Link = m.data.linkedin ? 'a' : 'span';
          const linkProps = m.data.linkedin ? { href: m.data.linkedin, target: '_blank', rel: 'noopener' } : {};
          return (
            <div class="member">
              <Link {...linkProps} class="avatar-link" aria-hidden="true" tabindex="-1">
                {m.data.photo
                  ? <img src={url(m.data.photo)} alt="" class="avatar" loading="lazy" />
                  : <div class="avatar initials">{initials(m.data.name)}</div>}
              </Link>
              <div>
                <p class="name"><Link {...linkProps}>{m.data.name}</Link></p>
                <p class="role">{m.data.role}</p>
                <p class="muted small">{[m.data.major, m.data.year].filter(Boolean).join(' · ')}</p>
                {m.body?.trim() && <p class="small bio">{m.body.trim()}</p>}
                {m.data.linkedin && <a href={m.data.linkedin} class="small li" target="_blank" rel="noopener">LinkedIn ↗</a>}
              </div>
            </div>
          );
        })}
      </div>
    </section>
  </div>
</Base>

<style>
  .team { display: grid; gap: 1.5rem; margin-top: 1.5rem; }
  @media (min-width: 640px) { .team { grid-template-columns: 1fr 1fr; } }
  @media (min-width: 960px) { .team { grid-template-columns: repeat(3, 1fr); } }
  .member { display: flex; gap: 1rem; align-items: flex-start; }
  .avatar { width: 4.5rem; height: 4.5rem; border-radius: 50%; object-fit: cover; flex-shrink: 0; }
  .initials {
    display: grid; place-items: center; background: var(--gold-20); color: var(--brown); border: 2px solid var(--gold);
    font-family: var(--serif); font-size: 1.4rem;
  }
  .avatar-link { flex-shrink: 0; border-radius: 50%; transition: transform 0.15s; }
  a.avatar-link:hover { transform: scale(1.04); }
  .name { font-weight: 600; margin: 0; }
  .name a { color: inherit; text-decoration: none; }
  .name a:hover { color: var(--accent); text-decoration: underline; }
  .role { margin: 0; color: var(--accent); font-size: 0.92rem; }
  .small { font-size: 0.88rem; margin: 0.2rem 0; }
  .bio { color: var(--ink-2); }
</style>
