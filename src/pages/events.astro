---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import EventCard from '../components/EventCard.astro';
import { club } from '../config';

// A recap of every meeting, newest first. Add a file after each meeting (with photos).
const meetings = (await getCollection('events')).sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());
---

<Base title="Meetings" description={`Recaps and photos from ${club.name} meetings.`}>
  <div class="wrap">
    <header class="page-head">
      <p class="eyebrow">Meetings</p>
      <h1>Past meetings</h1>
      <p class="lede">We meet {club.meetings.replace(' · ', ' in ')}. Everything is open to all students — here's what we've been up to.</p>
    </header>

    <section>
      {meetings.length > 0
        ? meetings.map((e) => <EventCard event={e} />)
        : <p class="empty">Meeting recaps will show up here after our first meeting.</p>}
    </section>
  </div>
</Base>
