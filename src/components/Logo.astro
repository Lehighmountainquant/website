---
// Club logo: mountain range with a rising chart line. Black lines by default;
// it inherits `color`, so CSS can recolor it anywhere.
interface Props { size?: number; class?: string; title?: string }
const { size = 32, class: cls, title } = Astro.props;
---

<svg
  class={cls}
  width={size}
  height={Math.round(size * 0.446)}
  viewBox="30 160 460 205"
  fill="none"
  stroke="currentColor"
  stroke-width="10"
  stroke-linecap="square"
  stroke-linejoin="miter"
  role={title ? 'img' : undefined}
  aria-hidden={title ? undefined : 'true'}
>
  {title && <title>{title}</title>}
  <!-- Mountain outline -->
  <polyline points="40,352 118,244 138,268 196,194 222,214 276,170 318,212 340,214 470,352 410,352" />
  <polyline points="40,352 136,352" />
  <!-- Rising chart line ending in an arrow -->
  <polyline points="136,352 200,277 228,298 266,263 322,263 428,186" />
  <polyline points="392,186 428,186 428,222" />
  <!-- Lower trend line -->
  <polyline points="200,352 250,352 282,311 340,311 372,337" />
  <polyline points="356,312 372,337 350,346" />
</svg>
