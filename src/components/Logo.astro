---
// Club logo (public/logo.jpg, from the club's LinkedIn page).
import { url } from '../lib/utils';

interface Props { size?: number; class?: string; title?: string }
const { size = 32, class: cls, title } = Astro.props;
---

<img
  class:list={['logo', cls]}
  src={url('/logo.jpg')}
  width={size}
  height={size}
  alt={title ?? ''}
  aria-hidden={title ? undefined : 'true'}
/>

<style>
  .logo { display: block; object-fit: contain; border-radius: 6px; }
</style>
